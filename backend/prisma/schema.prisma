datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum LoanStatus {
  Pending
  Approved
  Rejected
  Disbursing
  Repaying
  Completed
}

model Notification {
  id          String             @id @default(uuid())
  recipient   String
  type        String // "EMAIL" or "WEBHOOK"
  content     String // HTML for emails or JSON payload for webhooks
  status      NotificationStatus @default(Pending)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attempts    Int                @default(0)
  lastError   String?
  nextRetryAt DateTime?
}

model UnpinnedCid {
  id           String   @id @default(uuid())
  cid          String
  proposalId   String?
  success      Boolean
  pinataStatus Int?
  error        String?
  createdAt    DateTime @default(now())
}

enum VerificationStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  REPAID
  DEFAULTED
}

model Applicant {
  id                 String             @id @default(uuid())
  stellarAddress     String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  creditScore        Int?
  taxId              String?
  monthlyIncome      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  verificationResults VerificationResult[]
  loanApplications    LoanApplication[]
}

model VerificationResult {
  id             String    @id @default(uuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id])
  reportHash     String
  totalPayments  Int
  totalVolume    Float
  spanMonths     Float
  eligible       Boolean
  analyzedAt     DateTime  @default(now())
}

model LoanApplication {
  id                 String     @id @default(uuid())
  applicantId        String
  applicant          Applicant  @relation(fields: [applicantId], references: [id])
  escrowContractId   String?
  loanId             String?
  principal          Float
  status             LoanStatus @default(PENDING)
  createdAt          DateTime   @default(now())

  // New fields for repayment tracking
  dueDate            DateTime?
  missedPayments     Int        @default(0)
  lateFeeBalance     Float      @default(0)
  gracePeriodEndsAt  DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorAddress String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([actorAddress])
}

model Borrower {
  id              String              @id @default(uuid())
  stellarAddress  String              @unique
  escrowBalance   String              @default("0")
  loanOutstanding String              @default("0")
  totalDeposited  String              @default("0")
  totalDisbursed  String              @default("0")
  totalRepaid     String              @default("0")
  lastEventLedger Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  deposits        EscrowDeposit[]
  withdrawals     EscrowWithdrawal[]
  disbursements   LoanDisbursement[]
  repayments      LoanRepayment[]
}

model EscrowDeposit {
  id          String   @id @default(uuid())
  borrower    Borrower @relation(fields: [borrowerId], references: [id])
  borrowerId  String
  contractId  String
  amount      String
  ledger      Int
  eventHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([borrowerId])
  @@index([ledger])
}

model EscrowWithdrawal {
  id          String   @id @default(uuid())
  borrower    Borrower @relation(fields: [borrowerId], references: [id])
  borrowerId  String
  contractId  String
  amount      String
  ledger      Int
  eventHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([borrowerId])
  @@index([ledger])
}

model LoanDisbursement {
  id          String   @id @default(uuid())
  borrower    Borrower @relation(fields: [borrowerId], references: [id])
  borrowerId  String
  contractId  String
  amount      String
  ledger      Int
  eventHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([borrowerId])
  @@index([ledger])
}

model LoanRepayment {
  id          String   @id @default(uuid())
  borrower    Borrower @relation(fields: [borrowerId], references: [id])
  borrowerId  String
  contractId  String
  amount      String
  ledger      Int
  eventHash   String   @unique
  createdAt   DateTime @default(now())

  @@index([borrowerId])
  @@index([ledger])
}

model EventIndexerState {
  id                 String   @id @default(uuid())
  key                String   @unique
  lastProcessedLedger Int      @default(0)
  cursor             String?
  updatedAt          DateTime @updatedAt
}
