datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum NotificationStatus {
  Pending
  Sent
  Failed
}

enum LoanStatus {
  Pending
  Approved
  Rejected
  Disbursing
  Repaying
  Completed
}

model Notification {
  id          String             @id @default(uuid())
  recipient   String
  type        String // "EMAIL" or "WEBHOOK"
  content     String // HTML for emails or JSON payload for webhooks
  status      NotificationStatus @default(Pending)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attempts    Int                @default(0)
  lastError   String?
  nextRetryAt DateTime?
}

model UnpinnedCid {
  id           String   @id @default(uuid())
  cid          String
  proposalId   String?
  success      Boolean
  pinataStatus Int?
  error        String?
  createdAt    DateTime @default(now())
}

enum VerificationStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
}



enum WorkspaceRole {
  OWNER
  BUILDER
  VIEWER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Workspace {
  id           String                   @id @default(uuid())
  name         String
  slug         String                   @unique
  createdBy    String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
}

model WorkspaceMember {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  walletAddress String
  role          WorkspaceRole @default(VIEWER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([workspaceId, walletAddress])
  @@index([walletAddress])
}

model WorkspaceInvitation {
  id              String                     @id @default(uuid())
  workspaceId     String
  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviteeAddress  String
  invitedBy       String
  role            WorkspaceRole              @default(VIEWER)
  status          WorkspaceInvitationStatus  @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([inviteeAddress])
  @@index([status])
}

model Applicant {
  id                 String             @id @default(uuid())
  stellarAddress     String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  creditScore        Int?
  taxId              String?
  monthlyIncome      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  verificationResults VerificationResult[]
  loanApplications    LoanApplication[]
  borrowerCredentials BorrowerCredential[]
}

model VerificationResult {
  id             String    @id @default(uuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id])
  reportHash     String
  totalPayments  Int
  totalVolume    Float
  spanMonths     Float
  eligible       Boolean
  analyzedAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// KYC OCR auto-fill
// ---------------------------------------------------------------------------
//
// When a borrower uploads a KYC document the backend runs OCR extraction
// on the plaintext buffer (before encryption) and stores any extracted
// values here.  Each field carries an "unconfirmed" flag that the applicant
// must explicitly clear before the onboarding submission is accepted.
//
// Confirmation endpoint: POST /api/kyc/:documentId/confirm
//   Body: { confirmName?: true, confirmIdNumber?: true, confirmAddress?: true }
//
// The three extracted fields mirror the three onboarding fields that OCR
// is allowed to pre-fill: full legal name, government ID number, and
// residential address.
model KycOcrResult {
  id               String   @id @default(uuid())
  /// The KYC document this result was extracted from.
  documentId       String   @unique
  /// Wallet address of the applicant who uploaded the document.
  applicantAddress String

  /// Extracted full legal name, or null when OCR could not find it.
  extractedName     String?
  /// Whether the applicant has explicitly confirmed the extracted name.
  nameConfirmed     Boolean  @default(false)

  /// Extracted government-issued ID number (passport, national ID, etc.).
  extractedIdNumber String?
  /// Whether the applicant has explicitly confirmed the extracted ID number.
  idNumberConfirmed Boolean  @default(false)

  /// Extracted residential address.
  extractedAddress  String?
  /// Whether the applicant has explicitly confirmed the extracted address.
  addressConfirmed  Boolean  @default(false)

  /// True when OCR ran but could not extract any usable fields.
  ocrFailed  Boolean  @default(false)
  /// Raw OCR engine error message, if any.
  ocrError   String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([applicantAddress])
}

model LoanApplication {
  id                 String     @id @default(uuid())
  applicantId        String
  applicant          Applicant  @relation(fields: [applicantId], references: [id])
  escrowContractId   String?
  loanId             String?
  principal          Float
  status             LoanStatus @default(Pending)
  createdAt          DateTime   @default(now())

  // New fields for repayment tracking
  dueDate            DateTime?
  missedPayments     Int        @default(0)
  lateFeeBalance     Float      @default(0)
  gracePeriodEndsAt  DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorAddress String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([actorAddress])
}

model BorrowerCredential {
  id             String   @id @default(uuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id])
  did            String   @unique
  didHash        String   @unique
  verificationMethod     String
  challenge      String?
  issuer         String?
  verifiedAt     DateTime @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  isRevoked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([applicantId])
  @@index([did])
}

model WebhookDLQ {
  id              String   @id @default(uuid())
  url             String
  payload         Json
  statusCode      Int?
  responsePayload String?
  error           String?
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Webhook subscription model
// ---------------------------------------------------------------------------

/// The event topics a subscriber can opt into.
enum WebhookEventTopic {
  deposit
  withdraw
  release
  disburse
  repay
  /// Catch-all — subscriber receives every event kind.
  all
}

/// Lifecycle state of a subscription.
enum WebhookSubscriptionStatus {
  active
  paused
  revoked
}

/// A partner/third-party webhook endpoint registration.
/// Each subscription carries its own HMAC secret so secrets can be rotated
/// per subscriber without affecting any other subscription.
model WebhookSubscription {
  id          String                    @id @default(uuid())
  /// Human-readable label for the subscriber (e.g. "Acme Underwriter").
  label       String
  /// The HTTPS endpoint that will receive POST requests.
  url         String
  /// Per-subscription HMAC-SHA256 secret (stored encrypted at rest).
  secret      String
  /// Comma-separated list of event topics this subscription listens for,
  /// or a single "all" entry to receive everything.
  topics      WebhookEventTopic[]
  status      WebhookSubscriptionStatus @default(active)
  /// Optional owning wallet address — used to scope management API access.
  ownerAddress String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  deliveries  WebhookDelivery[]

  @@index([status])
  @@index([ownerAddress])
}

/// Immutable delivery attempt record — one row per HTTP attempt.
/// Successful deliveries and every retry attempt are all persisted so the
/// full dispatch history is always available for debugging.
model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// The event topic that triggered this delivery.
  topic          String
  /// Full JSON payload that was (or will be) sent.
  payload        Json
  /// HTTP status code returned by the target (null if the request never completed).
  statusCode     Int?
  /// Truncated response body from the target (max 2 KB stored).
  responseBody   String?
  /// Error message if the fetch itself threw (network error, timeout, etc.).
  error          String?
  /// Whether this attempt resulted in a 2xx response.
  success        Boolean             @default(false)
  /// Zero-based attempt index (0 = first try, 1 = first retry, …).
  attempt        Int                 @default(0)
  /// When the next retry should be attempted (null once terminal).
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
  @@index([success])
  @@index([nextRetryAt])
}
